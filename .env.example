# Arquivo de Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env e configure com seus valores

# Banco de Dados
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=latam
DB_CHARSET=utf8mb4

# Ambiente
APP_ENV=development
APP_DEBUG=true

# URLs
APP_URL=http://localhost
API_URL=http://localhost/api

# Integrações (se houver)
# WEBHOOK_URL=
# API_KEY=
# SECRET_KEY=

# Email (se configurado)
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=noreply@example.com

# Outras configurações
SESSION_LIFETIME=120
TIMEZONE=America/Sao_Paulo
